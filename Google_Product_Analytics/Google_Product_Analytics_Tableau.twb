          <zone h='29566' id='19' type-v2='text' w='97538' x='1231' y='69275'>
            <formatted-text>
              <run fontalignment='1'>* Of over 900K views on items, only around 50K led to items being carted and only around 11.5K led to items being purchased. This means that our biggest bottleneck on purchases is the stage from items being viewed to being put in the cart.</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>

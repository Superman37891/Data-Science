    <dashboard enable-sort-zone-taborder='true' name='Daily User &amp; Session Conversion Rates'>
      <style />
      <size maxheight='860' maxwidth='650' minheight='560' minwidth='420' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='76232' id='3' name='Date vs Active Users, User &amp; Session Conversion Rate' w='97538' x='1231' y='1159'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />

          </zone>
          <zone forceUpdate='true' h='21450' id='43' type-v2='text' w='97538' x='1231' y='77391'>
            <formatted-text>
              <run>Based on the very close to equal distributions for the user and session conversion rates, it seems that the conversion rates were approximately equal when counted by user or session. This strongly indicate that the user and session conversion rates are correlated. This could be true if the vast majority of users only have one session</run>
            </formatted-text>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />
              <format attr='border-width' value='0' />
              <format attr='margin' value='4' />
            </zone-style>

    <dashboard enable-sort-zone-taborder='true' name='Daily User &amp; Session Conversion Rates'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='76228' id='3' name='Date vs Active Users, User &amp; Session Conversion Rate' w='98556' x='722' y='1161'>
            <zone-style>
              <format attr='border-color' value='#000000' />
              <format attr='border-style' value='none' />

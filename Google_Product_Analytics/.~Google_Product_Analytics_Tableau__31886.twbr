    <dashboard enable-sort-zone-taborder='true' name='Retention Heatmap Dashboard'>
      <style />
      <size sizing-mode='automatic' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='97678' id='12' param='vert' type-v2='layout-flow' w='98556' x='722' y='1161'>
            <zone h='97678' id='8' param='horz' type-v2='layout-flow' w='98556' x='722' y='1161'>
              <zone h='97678' id='6' type-v2='layout-basic' w='98556' x='722' y='1161'>
                <zone forceUpdate='true' h='10015' id='3' type-v2='text' w='98556' x='722' y='1161'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontsize='20'>Retention Heatmap</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone h='63716' id='5' name='Retention Heatmap' w='98556' x='722' y='17997'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='6821' id='27' type-v2='text' w='98556' x='722' y='11176'>
                  <formatted-text>
                    <run fontalignment='1'>The percentage of users that initially visited the store in a certain month (vertical axis) that came back X months later (horizontal axis)</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='17126' id='52' type-v2='text' w='98556' x='722' y='81713'>
                  <formatted-text>
                    <run fontalignment='1'>The retention rate of users more than 1-3 months after first visiting the store is almost 0, and it is very low even 1-3 months after the initial visit. This implies that the vast majority of users do not come back to the store after their first visit, which could also explain why aggregate user-level and session-level data are almost identically distributed</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='margin' value='8' />
          </zone-style>
        </zone>
      </zones>

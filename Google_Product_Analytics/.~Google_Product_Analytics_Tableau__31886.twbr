          <datasource-dependencies datasource='federated.1d3ns5f1iefb091aepzu10u2tb5u'>
            <column caption='Avg. Rev. User Per Source' datatype='real' default-format='C1033%' name='[Calculation_2020160449081346]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED ([source]): &#10;    IF SUM([users]) = 0 THEN 0&#10;    ELSE SUM([revenue_usd]) / SUM([users])&#10;    END&#10;}' />
            </column>
            <column caption='FIltered_Sources_Avg_Revenue_User' datatype='string' name='[Calculation_2020160449970179]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF { FIXED [source] : SUM([Calculation_2020160449081346]) } &gt; 3&#10;THEN [source]&#10;ELSE &quot;Other&quot;&#10;END' />
            </column>
            <column caption='Avg. Rev. User' datatype='real' default-format='C1033%' name='[Calculation_2020160451293188]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_usd]) / SUM([users])' />
            </column>
            <column caption='Avg Rev. Session' datatype='real' default-format='C1033%' name='[Calculation_2020160453652488]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue_usd]) / SUM([sessions])' />

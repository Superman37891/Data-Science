      <aliases enabled='yes' />
      <column caption='Filtered_Sources_Revenue' datatype='string' name='[Calculation_2020160444411904]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [source] : SUM([revenue_usd]) } &gt; 10000&#10;THEN [source]&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Filtered_Sources_Users' datatype='string' name='[Calculation_2020160446308353]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [source] : SUM([users]) } &gt; 10000&#10;THEN [source]&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Avg. Rev. User Per Source' datatype='real' default-format='C1033%' name='[Calculation_2020160449081346]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED ([source]): &#10;    IF SUM([users]) = 0 THEN 0&#10;    ELSE SUM([revenue_usd]) / SUM([users])&#10;    END&#10;}' />
      </column>
      <column caption='FIltered_Sources_Avg_Revenue_User' datatype='string' name='[Calculation_2020160449970179]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [source] : SUM([Calculation_2020160449081346]) } &gt; 3&#10;THEN [source]&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Avg. Rev. User' datatype='real' default-format='C1033%' name='[Calculation_2020160451293188]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue_usd]) / SUM([users])' />
      </column>
      <column caption='Avg. Rev. Session Per Source' datatype='real' default-format='C1033%' name='[Calculation_2020160451612677]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED ([source]): &#10;    IF SUM([sessions]) = 0 THEN 0&#10;    ELSE SUM([revenue_usd]) / SUM([sessions])&#10;    END&#10;}' />
      </column>
      <column caption='Filtered_Sources_Avg_Revenue_Session' datatype='string' name='[Calculation_2020160451985415]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [source] :&#10;     SUM([revenue_usd]) / SUM([sessions])&#10;   } &gt; 3&#10;THEN [source]&#10;ELSE &quot;Other&quot;&#10;END' />
      </column>
      <column caption='Avg Rev. Session' datatype='real' default-format='C1033%' name='[Calculation_2020160453652488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([revenue_usd]) / SUM([sessions])' />
      </column>
      <column caption='Session Conv. Rate' datatype='real' default-format='p0.000%' name='[Calculation_2020160470114319]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions]) / Sum([sessions])' />
      </column>
      <column caption='User Conv. Rate' datatype='real' default-format='p0.000%' name='[Calculation_2020160470208528]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([transactions]) / SUM([users])' />
      </column>
